# Copy this file to .env in frontend/ and customize for your environment.

# Port the Vite dev server runs on (defaults to 5173)
PORT=5173

# Base path the app is served from
BASE_PATH=/

# Backend API Base URL (used by Vite proxy in dev or client in production)
# Local dev: http://localhost:8000/api/v1
# Production (Render): https://<your-backend-slug>.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
