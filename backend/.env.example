PROJECT_NAME="Skill-to-Income AI Engine (SIE)"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False
PORT=8000

# Primary Production Database (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-calm-sunset-az68onco.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL Fallback (used when DATABASE_URL is not set)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sie_db
POSTGRES_PORT=5432

# Connection Pooling Settings (Tuned for Neon Serverless)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=True
DB_POOL_RECYCLE=300

# Security & JWT Authentication
SECRET_KEY=generate_with_openssl_rand_hex_32_for_production
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS Whitelist (Comma-separated for multiple production/staging domains)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://skill-to-income.onrender.com

# Optional Groq LLM Inference API Key (Module 1 & 4 dynamic generation)
GROQ_API_KEY=gsk_your_groq_api_key_here