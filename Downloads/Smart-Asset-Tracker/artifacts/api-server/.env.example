# Copy this file to .env in artifacts/api-server/ and fill in real values.
# (The dev script loads it automatically if you use `pnpm dlx dotenv-cli`,
# or export these in your shell / VS Code launch config — see the setup guide.)

# Postgres connection string. Example for a local Postgres:
# postgresql://postgres:postgres@localhost:5432/sie
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sie

# Port the Express API listens on.
PORT=4000

# Long random string used to sign session cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# Set to "production" when deploying. Controls cookie `secure`/`sameSite`
# behavior (see src/lib/session.ts) and log formatting.
NODE_ENV=development

# The exact origin(s) of your frontend, comma-separated if more than one.
# Must match exactly (scheme + host + port) for session cookies to work.
CORS_ORIGIN=http://localhost:5173
